{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "outDir": "./dist",
    "sourceMap": true,
    "resolveJsonModule": true,
    "strictNullChecks": false
  },
  "include": ["./src/**/*.ts", "./src/**/*.js"],
  "exclude": ["./src/**/*.test.ts", "./dist", ".eslintrc.cjs", "node_modules"]
}
